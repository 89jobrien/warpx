[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=WarpX
GenericName=TerminalEmulator

Exec=warpx %U
StartupWMClass=dev.warp.WarpX

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.warp.WarpX

Categories=System;TerminalEmulator;

# Do not run this application within a terminal.
Terminal=false

# Register ourselves as the handler for warpx:// URLs.
MimeType=x-scheme-handler/warpx;
